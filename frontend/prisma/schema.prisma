generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  projects  Project[]
}

model Project {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  title       String
  rawPrompt   String?
  nodesJson   String
  edgesJson   String
  // Schema-level metadata: enums, table-group styling, diagram views, project settings.
  metaJson    String   @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Published, link-addressable snapshot of a diagram (public / password-protected / private).
model SharedDiagram {
  id           String   @id @default(cuid())
  slug         String   @unique
  title        String
  dbml         String
  layoutJson   String   @default("{}")
  visibility   String   @default("public") // public | password | private
  passwordHash String?
  passwordSalt String?
  // sha256 of the secret returned once at publish time; needed to update or unpublish
  editTokenHash String?
  views        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
